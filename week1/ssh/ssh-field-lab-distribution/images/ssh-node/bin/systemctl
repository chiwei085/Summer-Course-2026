#!/usr/bin/env python3
import sys

import robot_service_lib as service


def main() -> int:
    args = [arg for arg in sys.argv[1:] if arg != "--user"]
    if args == ["status", "navigation.service"]:
        return service.print_status()
    if args == ["restart", "navigation.service"]:
        return service.restart()
    print("field lab systemctl wrapper supports status/restart navigation.service", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
