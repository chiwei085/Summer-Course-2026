#!/usr/bin/env python3
from __future__ import annotations

import sys

import robot_service_lib as service


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: robot-service COMMAND", file=sys.stderr)
        return 2

    command = sys.argv[1]
    if command == "initialize":
        return service.initialize()
    if command == "status":
        return service.print_status()
    if command == "logs":
        return service.print_logs()
    if command == "validate" and len(sys.argv) == 3:
        return service.validate_command(sys.argv[2])
    if command == "restart":
        return service.restart()
    if command == "state-json":
        return service.print_state_json()

    print(f"unknown robot-service command: {command}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
