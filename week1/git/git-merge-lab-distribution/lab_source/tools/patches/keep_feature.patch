#include "velocity_controller.hpp"

#include <algorithm>

double VelocityController::compute_command(
    double current_velocity,
    double target_velocity) const
{
    const double error =
        target_velocity - current_velocity;

    return std::clamp(error, -2.0, 2.0);
}
